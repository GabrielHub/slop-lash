# Convex project connection (generated by `convex dev` or the Vercel integration)
CONVEX_DEPLOYMENT="dev:your-deployment"
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"

# Backend secrets are not local Next.js variables. Configure
# AI_GATEWAY_API_KEY, HOST_SECRET, GEMINI_API_KEY, and FAL_KEY with:
#   vp exec convex env set <NAME>
