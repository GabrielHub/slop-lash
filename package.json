{
  "name": "slop-lash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "check": "vp check",
    "check:theme-colors": "node scripts/check-theme-colors.mjs",
    "quizslop:catalog:validate": "node --no-warnings --experimental-transform-types --import ./scripts/quizslop/register-ts-loader.mjs scripts/quizslop/validate-catalog.ts",
    "quizslop:catalog:validate-approved": "node --no-warnings --experimental-transform-types --import ./scripts/quizslop/register-ts-loader.mjs scripts/quizslop/validate-catalog.ts --require-approved",
    "quizslop:catalog:review": "node --no-warnings --experimental-transform-types --import ./scripts/quizslop/register-ts-loader.mjs scripts/quizslop/render-catalog-review.ts",
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.77",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/workpool": "0.4.13",
    "@fal-ai/client": "1.10.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.134",
    "canvas-confetti": "^1.9.4",
    "convex": "^1.46.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "0.0.60",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.10.1"
}
